# PieceWork job: the same transcription as transcribe:v1, on the GPU a sealing rig already owns.
# Contract unchanged: inputs in /in (read-only), results in /out, run with --network none.
#   docker build -f Dockerfile.gpu -t piecework/transcribe-gpu:v1 .
#
# Why this is the workload that justifies the hardware, where embeddings were not: embedding a document is
# small and bursty, and a CPU keeps up. Speech is a long serial grind over hours of audio, and the gap is not
# subtle — a CPU runs Whisper small at roughly real time, while a card from a sealing rig runs the much better
# large-v3-turbo at twenty to forty times real time. The same ten hours of recordings: a long afternoon on a
# laptop, or four minutes on a 3090 that is otherwise idle.
#
# Needs the nvidia container toolkit on the provider and about 6 GB of free VRAM. A V100, 3090, 4090 or A4000
# all clear that comfortably. No H100 required, which is the point: this runs on cards bought for sealing.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip \
 && rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir "faster-whisper==1.1.1" requests
# Both models, because one number on its own proves nothing. Running large-v3-turbo on a card and comparing
# it to small on a processor changes the hardware and the model at the same time, and the result cannot be
# attributed to either. With small present here too, the same model can be timed on both devices — that
# difference is the hardware — and turbo against small on the same card says what the extra capacity buys.
# It costs about 250 MB next to turbo's bulk.
RUN python3 -c "from faster_whisper.utils import download_model; download_model('large-v3-turbo', output_dir='/models/large-v3-turbo')" \
 && python3 -c "from faster_whisper.utils import download_model; download_model('small', output_dir='/models/small')"
ENV HF_HUB_OFFLINE=1 MODEL_DIR=/models/large-v3-turbo DEVICE=cuda COMPUTE_TYPE=float16
COPY transcribe.py /app/transcribe.py
LABEL org.piecework.job="transcribe-gpu" \
      org.piecework.inputs="/in/*.mp3 /in/*.m4a /in/*.wav /in/*.mp4 /in/*.mov /in/*.mkv /in/*.webm" \
      org.piecework.outputs="/out/*-transcript.txt /out/*-subtitles.srt /out/*-segments.jsonl /out/transcribe-report.txt"
ENTRYPOINT ["python3", "/app/transcribe.py"]
