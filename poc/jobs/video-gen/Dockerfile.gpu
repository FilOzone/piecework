# PieceWork job: the same video loop, with a real model instead of the motion stand-in.
# Contract unchanged: inputs in /in (read-only), results in /out, run with --network none.
#   docker build -f Dockerfile.gpu -t piecework/video-gen-gpu:v1 .
#
# The CPU Dockerfile has said since it was written that "the model version is Dockerfile.gpu and goes
# behind the same interface". That file did not exist, so the sentence was a promise. This is it, and the
# interface claim is literal: the same generate.py, the same version-N.mp4 and version-N.json, the same
# manifest naming every input by sha256 and the parent it was built on. GENERATOR=svd picks the model path;
# everything downstream -- the lineage chain, the client page, the storage -- does not know the difference.
#
# This is a GPU-only row and not for emphasis. Stable Video Diffusion on a processor is hours per clip;
# the job refuses rather than running for an afternoon and reporting a number nobody can compare with the
# motion row's one second.
#
# VRAM: SVD img2vid-xt in fp16 is about 9 GB of weights, and model CPU offload keeps the working set under
# a T4's 16 GB at 1024x576. That fits the fleet, which matters because Turing and Volta cards cannot do
# bf16 at all -- fp16 is the only option here, not a preference.
#
# Weights baked at build time: the job runs with --network none. The image is correspondingly large
# (~12 GB); that is the cost of a job that cannot reach for its model at run time.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip ffmpeg libgl1 libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir torch==2.5.1 --index-url https://download.pytorch.org/whl/cu124 \
 && pip3 install --no-cache-dir diffusers==0.31.0 transformers==4.44.2 accelerate==0.34.2 \
      opencv-python-headless==4.10.0.84 numpy==2.1.3 pillow==10.4.0
RUN python3 -c "\
from diffusers import StableVideoDiffusionPipeline; import torch; \
StableVideoDiffusionPipeline.from_pretrained('stabilityai/stable-video-diffusion-img2vid-xt', \
  torch_dtype=torch.float16, variant='fp16').save_pretrained('/models/svd', variant='fp16')"
ENV GENERATOR=svd DEVICE=cuda MODEL=/models/svd NUM_FRAMES=25 CHUNK=4 MOTION=127
COPY generate.py /app/generate.py
LABEL org.piecework.job="video-gen-gpu" org.piecework.inputs="/in/*.jpg /in/*.png /in/prompt.json" \
      org.piecework.outputs="/out/version-N.mp4 /out/version-N.json /out/video-gen-report.txt"
ENTRYPOINT ["python3", "/app/generate.py"]
