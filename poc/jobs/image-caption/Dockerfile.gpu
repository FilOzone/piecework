# PieceWork job: describe each image in words, on the GPU a sealing or farming rig already owns.
# Contract unchanged: inputs in /in (read-only), results in /out, run with --network none.
#   docker build -f Dockerfile.gpu -t piecework/image-caption-gpu:v1 .
#
# This is a GPU-only row, and deliberately so. image-index's COCO detector runs fine on a processor and
# answers "is there a person in this" well; its vocabulary is eighty fixed categories, so it cannot name a
# racing car and says "truck". A vision-language model describes instead of classifying and has no such
# limit -- but a forward pass is seconds per image on a processor against well under one on a T4, which is
# the difference between a service and a thing nobody would order. The job refuses to run without a card
# rather than reporting a processor time that cannot be compared with anything.
#
# Florence-2-base: ~0.23B parameters, about 0.5 GB in fp16. It fits any sealing card many times over -- a
# T4's 16 GB is not remotely the constraint here, which matters because the fleet is Turing and Volta and
# cannot do bf16 at all.
#
# Weights baked at build time: the job runs with --network none and a model that downloads on first use
# works perfectly in testing and fails on every real job.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip \
 && rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir torch==2.5.1 torchvision==0.20.1 --index-url https://download.pytorch.org/whl/cu124 \
 && pip3 install --no-cache-dir transformers==4.44.2 pillow==10.4.0 timm==1.0.9 einops==0.8.0
ENV HF_HOME=/models/hf
RUN python3 -c "\
from unittest.mock import patch; \
from transformers.dynamic_module_utils import get_imports; \
patch('transformers.dynamic_module_utils.get_imports', lambda f: [i for i in get_imports(f) if i != 'flash_attn']).start(); \
from transformers import AutoProcessor, AutoModelForCausalLM; \
m='microsoft/Florence-2-base'; \
AutoModelForCausalLM.from_pretrained(m, trust_remote_code=True).save_pretrained('/models/florence'); \
AutoProcessor.from_pretrained(m, trust_remote_code=True).save_pretrained('/models/florence')"
ENV DEVICE=cuda MODEL=/models/florence MAX_TOKENS=128
COPY caption.py /app/caption.py
LABEL org.piecework.job="image-caption-gpu" org.piecework.inputs="/in/*.jpg /in/*.png" \
      org.piecework.outputs="/out/*-caption.txt /out/image-caption.json /out/image-caption-report.txt"
ENTRYPOINT ["python3", "/app/caption.py"]
