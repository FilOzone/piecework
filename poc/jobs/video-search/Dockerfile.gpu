# PieceWork job: make an archive searchable by describing what you want, on the provider's GPU.
# Contract unchanged: inputs in /in (read-only), results in /out, run with --network none.
#   docker build -f Dockerfile.gpu -t piecework/video-search-gpu:v1 .
#
# This is the generalisation of video-index. That job runs a COCO detector and can therefore find exactly
# eighty things: "person", "car", and seventy-eight others. This embeds frames into the same space as text,
# so the question can be any phrase and does not have to be known when the video was indexed -- which is
# what an unlabelled archive actually needs.
#
# GPU-only, and it refuses rather than falling back. A forward pass per sampled frame is the shape of work
# a card does tens of times faster, and an archive is precisely the case where that decides whether anyone
# would order the job at all.
#
# CLIP ViT-B/32: about 600 MB, which no sealing card will notice. The fleet constraint here is not memory
# but architecture -- Turing and Volta cannot do bf16, so fp32 weights and fp16 activations it is.
#
# Weights baked at build time: the job runs with --network none, and a model that downloads on first use
# works in testing and fails on every real job.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip libgl1 libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir torch==2.5.1 --index-url https://download.pytorch.org/whl/cu124 \
 && pip3 install --no-cache-dir transformers==4.44.2 opencv-python-headless==4.10.0.84 \
      numpy==2.1.3 pillow==10.4.0
RUN python3 -c "\
from transformers import CLIPModel, CLIPProcessor; m='openai/clip-vit-base-patch32'; \
model = CLIPModel.from_pretrained(m); model.save_pretrained('/models/clip', state_dict={k: v.contiguous() for k, v in model.state_dict().items()}); \
CLIPProcessor.from_pretrained(m).save_pretrained('/models/clip')"
ENV DEVICE=cuda MODEL=/models/clip SAMPLE_FPS=1 BATCH=32
COPY search.py /app/search.py
LABEL org.piecework.job="video-search-gpu" org.piecework.inputs="/in/*.mp4 /in/queries.json" \
      org.piecework.outputs="/out/*-vectors.npy /out/*-search.txt /out/video-search-report.txt"
ENTRYPOINT ["python3", "/app/search.py"]
