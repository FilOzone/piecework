        ".md",
        ".csv"
      ]
    },
    "indexer:v1": {
      "name": "Build a search index of my files",
      "price": "0.5",
      "outputs": [
        "search-index.txt"
      ],
      "deadlineEpochs": 40,
      "inputExtensions": [
        ".txt",
        ".md",
        ".csv"
      ]
    }
  },
  "policies": [
    {
      "id": "keep",
      "label": "Keep everything (default)"
