{
  "pii-redact:v1": {
    "name": "Find and remove personal data in my documents",
    "dockerImage": "piecework/pii-redact:v1",
    "outputs": [
      "pii-report.txt",
      "redacted-documents.txt"
    ],
    "inputExtensions": [
      ".txt"
    ]
  },
  "indexer:v1": {
    "name": "Build a search index of my files",
    "dockerImage": "alpine:3.20",
    "outputs": [
      "search-index.txt"
    ],
    "script": "for f in /in/*; do tr 'A-Z' 'a-z' < \"$f\" | tr -cs 'a-z0-9' '\\n' | grep -E '^.{5,}$' | sort -u | sed \"s|$| $(basename \"$f\")|\"; done | awk '{a[$1]=a[$1]\" \"$2} END{for (w in a) print w \":\" a[w]}' | sort > /out/search-index.txt",
    "inputExtensions": [
      ".txt",
      ".md",
      ".csv"
    ]
  },
  "embed:v1": {
    "name": "Make my documents searchable by meaning (embeddings)",
    "dockerImage": "piecework/embed:v1",
    "outputs": [
      "embeddings.jsonl",
      "embeddings-report.txt"
    ],
    "price": "0.3",
    "inputExtensions": [
      ".txt",
      ".md",
      ".csv"
    ]
  },
  "embed-gpu:v1": {
    "name": "Make my documents searchable by meaning, on the GPU",
    "dockerImage": "piecework/embed-gpu:v1",
    "gpu": true,
    "outputs": [
      "embeddings.jsonl",
      "embeddings-report.txt"
    ],
    "price": "0.3",
    "inputExtensions": [
      ".txt",
      ".md",
      ".csv"
    ]
  },
  "query:v1": {
    "name": "Run my SQL over my tables",
    "dockerImage": "piecework/query:v1",
    "outputs": [
      "results.csv",
      "query-report.txt"
    ],
    "price": "0.3",
    "inputExtensions": [
      ".sql",
      ".csv",
      ".parquet",
      ".json",
      ".jsonl"
    ]
  },
  "transcode:v1": {
    "name": "Re-encode my video, smaller",
    "dockerImage": "piecework/transcode:v1",
    "outputs": "*",
    "price": "0.5",
    "inputExtensions": [
      ".mp4",
      ".mov",
      ".mkv",
      ".avi",
      ".webm",
      ".m4v"
    ]
  },
  "transcribe:v1": {
    "name": "Transcribe my recordings (and make them searchable by the moment)",
    "dockerImage": "piecework/transcribe:v1",
    "outputs": "*",
    "price": "0.5",
    "inputExtensions": [
      ".mp3",
      ".m4a",
      ".wav",
      ".flac",
      ".ogg",
      ".opus",
      ".mp4",
      ".mov",
      ".mkv",
      ".webm",
      ".m4v"
    ]
  },
  "transcribe-gpu:v1": {
    "name": "Transcribe my recordings, on the GPU (bigger model, ~20x faster)",
    "dockerImage": "piecework/transcribe-gpu:v1",
    "gpu": true,
    "outputs": "*",
    "price": "0.5",
    "inputExtensions": [
      ".mp3",
      ".m4a",
      ".wav",
      ".flac",
      ".ogg",
      ".opus",
      ".mp4",
      ".mov",
      ".mkv",
      ".webm",
      ".m4v"
    ]
  },
  "transcode-gpu:v1": {
    "name": "Re-encode my video, smaller, on the GPU",
    "dockerImage": "piecework/transcode-gpu:v1",
    "gpu": true,
    "outputs": "*",
    "price": "0.5",
    "inputExtensions": [
      ".mp4",
      ".mov",
      ".mkv",
      ".avi",
      ".webm",
      ".m4v"
    ]
  },
  "term-count-proved:v1": {
    "name": "Count a term, and prove it ran on the client's data",
    "prove": true,
    "proverImage": "piecework/sp1:v6",
    "term": "payment",
    "outputs": [
      "term-count.txt"
    ],
    "price": "0.5",
    "inputExtensions": [
      ".txt"
    ],
    "vkey": "0x0038c8f3827c1ba3c9396591d54c84aec5c15f8c24a39f7258734a2f8e9ad45e",
    "deadlineEpochs": 240
  },
  "term-count-attested:v1": {
    "name": "Count a term, and prove the count (not whose data)",
    "prove": true,
    "guest": "attested",
    "proverImage": "piecework/sp1:v6",
    "term": "payment",
    "outputs": [
      "term-count.txt"
    ],
    "price": "0.125",
    "inputExtensions": [
      ".txt"
    ],
    "vkey": "0x0096b367600f7d1b588460df38c64dc90f895ced7e3f6657a6e259dc92614beb",
    "deadlineEpochs": 240
  },
  "ocr:v1": {
    "name": "Read my scanned pages into text",
    "dockerImage": "piecework/ocr:v1",
    "outputs": "*",
    "price": "0.4",
    "inputExtensions": [
      ".png",
      ".jpg",
      ".jpeg",
      ".tif",
      ".tiff",
      ".bmp",
      ".pdf"
    ]
  },
  "ocr-gpu:v1": {
    "name": "Read my scanned pages into text (on the card)",
    "dockerImage": "piecework/ocr-gpu:v1",
    "gpu": true,
    "outputs": "*",
    "price": "0.4",
    "inputExtensions": [
      ".png",
      ".jpg",
      ".jpeg",
      ".tif",
      ".tiff",
      ".bmp",
      ".pdf"
    ]
  },
  "extract:v1": {
    "name": "Pull the facts out of my documents",
    "dockerImage": "piecework/extract:v1",
    "outputs": "*",
    "price": "0.4",
    "inputExtensions": [
      ".txt",
      ".md"
    ]
  },
  "extract-gpu:v1": {
    "name": "Pull the facts out of my documents (on the card)",
    "dockerImage": "piecework/extract-gpu:v1",
    "gpu": true,
    "outputs": "*",
    "price": "0.4",
    "inputExtensions": [
      ".txt",
      ".md"
    ]
  },
  "image-clean:v1": {
    "name": "Take the people, or the background, out of my photographs",
    "dockerImage": "piecework/image-clean:v1",
    "outputs": "*",
    "price": "0.4",
    "inputExtensions": [
      ".jpg",
      ".jpeg",
      ".png"
    ]
  },
  "image-clean-gpu:v1": {
    "name": "Take the people, or the background, out of my photographs (on the card)",
    "gpu": true,
    "dockerImage": "piecework/image-clean-gpu:v1",
    "outputs": "*",
    "price": "0.4",
    "inputExtensions": [
      ".jpg",
      ".jpeg",
      ".png"
    ]
  }
}
