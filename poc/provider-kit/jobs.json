      ".mov",
      ".mkv",
      ".avi",
      ".webm",
      ".m4v"
    ]
  },
  "term-count-proved:v1": {
    "name": "Count a term, and prove it ran on the client's data",
    "prove": true,
    "proverImage": "piecework/sp1:v6",
    "term": "payment",
    "outputs": [
      "term-count.txt"
    ],
    "price": "0.5",
    "inputExtensions": [
      ".txt"
    ],
    "vkey": "0x002faeef6f22ecb5f451643ff42c37ec420eb37f4e535ddcf14f72d0c6942d47",
    "deadlineEpochs": 240
  },
  "term-count-attested:v1": {
    "name": "Count a term, and prove the count (not whose data)",
    "prove": true,
    "guest": "attested",
    "proverImage": "piecework/sp1:v6",
    "term": "payment",
    "outputs": [
      "term-count.txt"
    ],
    "price": "0.125",
    "inputExtensions": [
      ".txt"
    ],
    "vkey": "0x0019f78dfa23d6ecc3140563c3746ba611461e81f5c70d9de052c22841d69cc0",
    "deadlineEpochs": 240
  },
